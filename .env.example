# ══════════════════════════════════════════════════════════════════════════════
# CONSTRUCTOR ADMIN — Variables de entorno (Supabase + Vercel)
# ══════════════════════════════════════════════════════════════════════════════

# ── BASE DE DATOS (Supabase) ──────────────────────────────────────────────────
# En Vercel/producción usa la URL del POOLER transaccional (puerto 6543):
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Para scripts de migración/DDL (pg_restore, seed) usa la conexión DIRECTA:
# SUPABASE_DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"
# En desarrollo local (Postgres propio) añade ?sslmode=disable o deja localhost.

# Tamaño del pool de conexiones por proceso (Vercel usa 3 por defecto)
PGPOOL_MAX=3

# ── SESIONES ──────────────────────────────────────────────────────────────────
# OBLIGATORIO en producción (las sesiones se guardan en la tabla user_sessions
# de Postgres vía connect-pg-simple). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por comas. Si frontend y backend viven en el
# mismo dominio de Vercel, esto es solo un seguro adicional.
CORS_ORIGINS="http://localhost:5173,https://demarq.vercel.app"

# ── ENTORNO ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# Solo para despliegue monolítico local/Render (Vercel lo sirve estático):
# SERVE_STATIC=1
